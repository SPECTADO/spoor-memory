{
  "name": "@spoor/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:db:up": "node scripts/test-db.mjs up",
    "test:db:down": "node scripts/test-db.mjs down",
    "bench:realistic": "tsx scripts/seed-realistic.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@spoor/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SPECTADO/spoor-memory.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/SPECTADO/spoor-memory#readme",
  "bugs": {
    "url": "https://github.com/SPECTADO/spoor-memory/issues"
  }
}
