# Copy to .env and fill in the blanks. .env is gitignored.
# Reference: docs/design/deployment.md section 5.

# ---- Compose only (read by docker-compose.yml, not by the app) ---------------------------------
# Use URL-safe characters only (they are embedded in connection URLs); `openssl rand -hex 24` is fine.
# Password of the `spoor` database superuser (used for CREATE EXTENSION at app startup only). REQUIRED.
POSTGRES_PASSWORD=
# Password of the `spoor_app` runtime role created by deploy/initdb/01-app-role.sh. REQUIRED.
POSTGRES_APP_PASSWORD=
# App image. The default is the local build (`docker compose up -d --build`). To run a published image set a
# version tag, e.g. ghcr.io/spectado/spoor-memory:0.1.0 (lowercase owner), and run `docker compose pull`.
SPOOR_IMAGE=spoor-memory:local
# Host port and bind address for the app. Use 127.0.0.1 behind caddy or another reverse proxy.
SPOOR_HTTP_PORT=3000
SPOOR_HTTP_BIND=0.0.0.0
# Public host name for Caddy. Set it when using `docker compose --profile caddy up -d`.
# SPOOR_DOMAIN=spoor.example.com

# ---- App ----------------------------------------------------------------------------------------
# Externally visible origin, no trailing path. Drives the origin check, cookie flags and every link.
# Must be exactly the URL users type (https://spoor.example.com when using caddy).
SPOOR_PUBLIC_URL=http://localhost:3000

# Bootstrap instance admin, read only while the users table is empty. REQUIRED on first start.
SPOOR_ADMIN_EMAIL=
SPOOR_ADMIN_PASSWORD=
SPOOR_ADMIN_NAME=Admin

# pino level: trace debug info warn error fatal
LOG_LEVEL=info

# Embedding provider new projects start with: local | openai | voyage (the latter two need their key).
SPOOR_EMBEDDING_DEFAULT=local
# ONNX intra-op threads of the local model (at most the CPUs given to the container).
SPOOR_EMBED_THREADS=2

# Optional OpenAI embeddings. Setting the key means item text leaves the instance.
SPOOR_OPENAI_API_KEY=
SPOOR_OPENAI_EMBED_MODEL=text-embedding-3-small
SPOOR_OPENAI_EMBED_DIMS=1536

# Optional Voyage embeddings. Model and dimensions are required when the key is set.
SPOOR_VOYAGE_API_KEY=
SPOOR_VOYAGE_EMBED_MODEL=
SPOOR_VOYAGE_EMBED_DIMS=

# Reverse proxies whose X-Forwarded-For is believed (device approval page's requester IP only). Unset = off:
# the TCP peer is shown. Comma-separated: loopback, private, addresses, CIDR ranges. With the caddy profile: private,
# and then also SPOOR_HTTP_BIND=127.0.0.1: `private` trusts every RFC 1918 peer, so with the app port published on
# 0.0.0.0 any client on your LAN or VPN that reaches :3000 directly could forge the "Requested from" address.
# The address used is the right-most X-Forwarded-For hop that is not a trusted proxy.
SPOOR_TRUST_PROXY=

# ---- Set by compose or the image; only change for a non-compose deployment -----------------------
# DATABASE_URL=postgres://spoor_app:...@db:5432/spoor        (runtime role, NOSUPERUSER, REQUIRED)
# DATABASE_MIGRATE_URL=postgres://spoor:...@db:5432/spoor    (superuser, CREATE EXTENSION at startup; unset = extensions must exist)
# SPOOR_PORT=3000
# SPOOR_HOST=0.0.0.0
# SPOOR_DB_POOL_MAX=10
# SPOOR_JOBS=on                      # off disables the in-process scheduler
# SPOOR_WEB_DIR=/app/web            # image default; outside the image: packages/web/dist
# SPOOR_MIGRATIONS_DIR=/app/drizzle  # image default; outside the image: the server package's drizzle folder
# NODE_ENV=production                # set by the image; do not change
# SPOOR_MODEL_DIR=/opt/spoor/models
# Every secret also accepts a <NAME>_FILE variant (DATABASE_URL_FILE, DATABASE_MIGRATE_URL_FILE,
# SPOOR_ADMIN_PASSWORD_FILE, SPOOR_OPENAI_API_KEY_FILE, SPOOR_VOYAGE_API_KEY_FILE) for Docker secrets.
